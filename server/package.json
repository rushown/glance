{
  "name": "glance-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Glance backend: Telegram (MTProto), Claude, speech-to-text and TON payments for Even G2 glasses",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tg:login": "tsx --env-file-if-exists=.env src/cli-login.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "@ton/core": "^0.63.1",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
