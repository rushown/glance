# ── Core ───────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
# Shared secret the glasses app sends as "Authorization: Bearer <token>".
# Generate with:  openssl rand -hex 32
APP_TOKEN=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins (CORS). "*" is OK because
# every API route also requires APP_TOKEN.
CORS_ORIGINS=*
DATA_DIR=./data
LOG_LEVEL=info

# ── AI: open models, free (triage, reply drafts, digests, free-form commands) ──
# Any OpenAI-compatible chat endpoint. Leave LLM_BASE_URL empty to run on rules only.
#   Local (default):  Ollama    LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:3b
#   (docker compose starts Ollama for you at http://ollama:11434/v1)
#   Faster, free tier: Groq     LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant  LLM_API_KEY=gsk_...
#   Also works with llama.cpp server, vLLM, LM Studio, OpenRouter.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
# Hard limit per model call, and how long reply drafts wait before rule-based drafts are shown.
LLM_TIMEOUT_MS=45000
LLM_FAST_MS=6000

# ── Speech-to-text: open-source Whisper ───────────────────────────────
# whisper  = any OpenAI-compatible /audio/transcriptions server, no key needed locally:
#            speaches/faster-whisper (docker compose starts it at http://whisper:8000/v1),
#            whisper.cpp server, or Groq (STT_BASE_URL=https://api.groq.com/openai/v1, STT_MODEL=whisper-large-v3-turbo, STT_API_KEY=gsk_...)
# none     = voice disabled (typed commands still work)
STT_PROVIDER=whisper
STT_API_KEY=
STT_BASE_URL=http://localhost:8000/v1
STT_MODEL=Systran/faster-whisper-small
STT_LANGUAGE=en

# ── Telegram ───────────────────────────────────────────────────────────
# live = real Telegram account via MTProto (needs API ID/hash from https://my.telegram.org)
# mock = built-in demo chats (no Telegram account needed)
TELEGRAM_MODE=mock
TG_API_ID=
TG_API_HASH=

# ── TON payments ───────────────────────────────────────────────────────
TON_NETWORK=testnet
# Wallet that receives bill-split / payment-request funds.
TON_WALLET_ADDRESS=
# Optional; raises toncenter rate limits. https://t.me/tonapibot
TONCENTER_API_KEY=
# Fiat currency used when the user says an amount without a currency.
DEFAULT_FIAT=USD
# How often to check the wallet for incoming payments (ms).
PAYMENT_POLL_MS=8000
