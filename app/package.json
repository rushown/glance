{
  "name": "glance-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Glance for Even G2: Telegram inbox, voice replies and TON bill splitting on your glasses",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "simulate": "evenhub-simulator http://localhost:5173",
    "manifest": "node scripts/gen-manifest.mjs",
    "pack": "npm run build && node scripts/gen-manifest.mjs && evenhub pack app.json dist -o glance.ehpk --sdk-ver 0.0.16",
    "test": "vitest run"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
