# Copy to .env.production before `npm run pack`.
# Public HTTPS origin of your Glance server. It is baked into the app's
# network whitelist (Even Hub requires exact origins, no wildcards).
VITE_SERVER_URL=https://glance.example.com
# Optional: pre-fill the access token so the glasses work with zero setup.
# Leave empty to enter it once in the phone UI instead.
VITE_APP_TOKEN=
